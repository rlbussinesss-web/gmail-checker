{
  "name": "gmail-checker",
  "version": "1.0.0",
  "description": "Gmail Checker Pro - Email credential validator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "pkg . -o gmail-checker.exe --targets win-x64"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "win-x64"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "nodemailer": "^6.9.7",
    "body-parser": "^1.20.2",
    "imap": "^0.8.19",
    "playwright": "^1.40.0"
  }
}
